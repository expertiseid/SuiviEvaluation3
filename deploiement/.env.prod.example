# Copier en .env.prod sur le serveur (jamais versionné) et remplir.
POSTGRES_DB=se_platform
POSTGRES_USER=se_platform
POSTGRES_PASSWORD=
DATABASE_URL=postgres://se_platform:MOT_DE_PASSE@db:5432/se_platform
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.plateforme.exemple.com,plateforme.exemple.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://plateforme.exemple.com,https://*.plateforme.exemple.com
MULTI_ORGANISATIONS=True
DOMAINE_PLATEFORME=plateforme.exemple.com
PLAINTES_URL_PUBLIQUE=https://plateforme.exemple.com
REDIS_URL=redis://redis:6379/0
# Courriel (code de connexion obligatoire : sans serveur de courriel, personne ne peut se connecter).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
COURRIEL_ABONNEMENTS=
# Adresse d'écoute de Nginx (le serveur web en amont s'y connecte).
PORT_WEB=127.0.0.1:8097
