# Base de données
POSTGRES_DB=se_platform
POSTGRES_USER=se_platform
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://se_platform:changeme@db:5432/se_platform

# Django
DJANGO_SECRET_KEY=changeme-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1,backend

# JWT
JWT_ACCESS_LIFETIME_MIN=45
JWT_REFRESH_LIFETIME_DAYS=7
# Déconnexion après X minutes sans activité (0 : jamais)
SESSION_INACTIVITE_MIN=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5192

# Frontend
VITE_API_BASE_URL=http://localhost:8093/api/v1

# Plaintes : clé de chiffrement des données protégées (récits, coordonnées, notes).
# Obligatoire en production ; la générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vide en développement : clé dérivée de DJANGO_SECRET_KEY. Ne jamais la perdre ni la changer sans rotation
# (« nouvelle,ancienne ») : les données chiffrées deviendraient illisibles.
PLAINTES_CLE_CHIFFREMENT=

# Plaintes : messages au plaignant.
# Adresse publique de la plateforme (lien de suivi dans les messages).
PLAINTES_URL_PUBLIQUE=http://localhost:5192
# Passerelle SMS : POST JSON {to, message, from} avec « Authorization: Bearer <jeton> ». Vide : envoi simulé.
PLAINTES_SMS_URL=
PLAINTES_SMS_JETON=
PLAINTES_SMS_EXPEDITEUR=

# Plaintes : pièces jointes, toujours chiffrées, dans un répertoire privé hors de toute racine web
# (à sauvegarder avec la base ; volume persistant en production). Vide : backend/prive/plaintes.
PLAINTES_STOCKAGE_PRIVE=
# Plafond de la plateforme par fichier (Mo) et durée des liens de téléchargement (minutes, 1 à 15).
PLAINTES_PLAFOND_PIECE_MO=10
PLAINTES_DUREE_LIEN_PIECE_MIN=5

# Code de connexion envoyé par courriel à chaque connexion, pour tous les comptes (chaque compte doit
# avoir une vraie adresse). Ne mettre False que sur un poste de développement ou si l'envoi est en panne.
DOUBLE_AUTH_OBLIGATOIRE=True

# Page d'accueil et démonstration.
# MODE_DEMO=True SEULEMENT sur l'installation de démonstration (données fictives : python manage.py preparer_demo).
# Sur une installation d'organisation, URL_DEMO = adresse de la démo (bouton « Essayer la démo »).
MODE_DEMO=False
URL_DEMO=
# Profils d'organisations créés depuis la page d'accueil, envoyés à cette adresse d'Expertise-ID.
INSCRIPTIONS_OUVERTES=True
# Plusieurs adresses possibles, séparées par des virgules (ex. monitora@…,alexido@…).
COURRIEL_ABONNEMENTS=
# Paiement en ligne de l'abonnement (CinetPay) : payé, l'espace est créé aussitôt (Expertise-ID peut le
# suspendre depuis la console). Clé sk_test_ : bac à sable ; sk_live_ : paiements réels. Vide : pas de paiement en ligne.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Tarifs payés en ligne : un mois de l'offre Standard, et une tranche de 10 Go ajoutée (par mois).
ABONNEMENT_DEVISE=XOF
ABONNEMENT_PRIX_MOIS=50000
ABONNEMENT_PRIX_TRANCHE=3000
# Adresse du site vitrine (retour après le paiement) : vide = adresse de la plateforme. Poste de développement :
URL_SITE=http://localhost:5193
# Dossier des fichiers téléversés (vide : backend/media).
MEDIA_ROOT=

# Plateforme multi-organisations : un sous-domaine et une base par organisation sur ce serveur.
# En développement : MULTI_ORGANISATIONS=True, DOMAINE_PLATEFORME=localhost, VITE_API_BASE_URL=/api/v1,
# puis http://<sous-domaine>.localhost:5192 (créer un espace : python manage.py creer_organisation …).
MULTI_ORGANISATIONS=False
DOMAINE_PLATEFORME=localhost

# Courriel réel (ex : messagerie LWS de expertise-id.com) — sinon les courriels s'affichent dans la console.
# EMAIL_BACKEND=apps.core.courriel.EmailBackendFiltre
# EMAIL_HOST=mail.expertise-id.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=adresse@expertise-id.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Expertise-ID Monitora <adresse@expertise-id.com>
# Facultatif : restreindre les envois à ces destinataires (vide : toute adresse réelle ; les adresses
# fictives example.org, .test… des comptes de démonstration ne sont jamais servies).
# EMAIL_DESTINATAIRES_AUTORISES=@expertise-id.com
