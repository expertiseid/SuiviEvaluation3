# Base de données
POSTGRES_DB=se_platform
POSTGRES_USER=se_platform
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://se_platform:changeme@db:5432/se_platform

# Django
DJANGO_SECRET_KEY=changeme-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# JWT
JWT_ACCESS_LIFETIME_MIN=45
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5192

# Frontend
VITE_API_BASE_URL=http://localhost:8093/api/v1

# Plaintes : clé de chiffrement des données protégées (récits, coordonnées, notes).
# Obligatoire en production ; la générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vide en développement : clé dérivée de DJANGO_SECRET_KEY. Ne jamais la perdre ni la changer sans rotation
# (« nouvelle,ancienne ») : les données chiffrées deviendraient illisibles.
PLAINTES_CLE_CHIFFREMENT=
