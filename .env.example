# Base de données
POSTGRES_DB=se_platform
POSTGRES_USER=se_platform
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://se_platform:changeme@db:5432/se_platform

# Django
DJANGO_SECRET_KEY=changeme-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# JWT
JWT_ACCESS_LIFETIME_MIN=45
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5192

# Frontend
VITE_API_BASE_URL=http://localhost:8093/api/v1

# Plaintes : clé de chiffrement des données protégées (récits, coordonnées, notes).
# Obligatoire en production ; la générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vide en développement : clé dérivée de DJANGO_SECRET_KEY. Ne jamais la perdre ni la changer sans rotation
# (« nouvelle,ancienne ») : les données chiffrées deviendraient illisibles.
PLAINTES_CLE_CHIFFREMENT=

# Plaintes : messages au plaignant.
# Adresse publique de la plateforme (lien de suivi dans les messages).
PLAINTES_URL_PUBLIQUE=http://localhost:5192
# Passerelle SMS : POST JSON {to, message, from} avec « Authorization: Bearer <jeton> ». Vide : envoi simulé.
PLAINTES_SMS_URL=
PLAINTES_SMS_JETON=
PLAINTES_SMS_EXPEDITEUR=

# Plaintes : pièces jointes, toujours chiffrées, dans un répertoire privé hors de toute racine web
# (à sauvegarder avec la base ; volume persistant en production). Vide : backend/prive/plaintes.
PLAINTES_STOCKAGE_PRIVE=
# Plafond de la plateforme par fichier (Mo) et durée des liens de téléchargement (minutes, 1 à 15).
PLAINTES_PLAFOND_PIECE_MO=10
PLAINTES_DUREE_LIEN_PIECE_MIN=5

# Courriel réel (ex : messagerie LWS de expertise-id.com) — sinon les courriels s'affichent dans la console.
# EMAIL_BACKEND=apps.core.courriel.EmailBackendFiltre
# EMAIL_HOST=mail.expertise-id.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=adresse@expertise-id.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Plateforme Suivi-Évaluation <adresse@expertise-id.com>
# Facultatif : restreindre les envois à ces destinataires (vide : toute adresse réelle ; les adresses
# fictives example.org, .test… des comptes de démonstration ne sont jamais servies).
# EMAIL_DESTINATAIRES_AUTORISES=@expertise-id.com
